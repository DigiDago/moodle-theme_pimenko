{{!
    @template theme_pimenko/completioncheck

    Case à cocher de complétion d'activité avec attributs de données.

    Example context (json):
    {
        "tooltiptext": "Marquer comme terminé",
        "status": "checked",
        "class": "completioncheckbox",
        "modid": 34,
        "state": 1,
        "modname": "assign",
        "completionicon": "https://example.com/check.svg",
        "changetext": "Cliquez pour changer l'état"
    }
}}
<div class="checkbox d-flex flex-row">
    <label id="completion-block" data-toggle="tooltip" title="{{tooltiptext}}">
        <input type="checkbox" {{status}} class="{{class}}" value="" data-mod="{{modid}}"
               data-completionstate="{{state}}"
               data-modulename="{{{modname}}}"
               data-id="{{modid}}"
               data-image="{{completionicon}}"
               data-changetext="{{{changetext}}}"
               data-msg="">
            {{#displayicon}}
                {{#pix}} t/check {{/pix}}
            {{/displayicon}}
    </label>
</div>
